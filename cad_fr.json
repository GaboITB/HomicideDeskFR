 "multilingual": {
  "#hdfr:5:1387118065:30c6969b91875ea28d18": "ALARME",
  "#hdfr:55:2028176546:207b5a8872d9c7b206bc": "Alarme déclenchée dans un commerce, {loc}. Détenteur des clés prévenu.",
  "#hdfr:9:1308507065:67e026232daddbbdc857": "ACCIDENT",
  "#hdfr:51:1678093037:faa129dc78821b163c73": "Collision entre deux véhicules, {loc}. Aucun blessé signalé.",
  "#hdfr:5:168627229:d331ebe20ee3073f359d": "TAPAGE",
  "#hdfr:41:967166977:dc0ed5f4ce822e487dcd": "Plainte pour tapage, {loc}. Résident rappelé à l'ordre.",
  "#hdfr:11:765992420:9d7641eff33c0c610e09": "PLAQUE",
  "#hdfr:48:1002712928:21ba2c483e7b8a10a1d7": "Vérification de plaque demandée près de {loc}. Rien à signaler.",
  "#hdfr:7:2136925847:7085daa46ee255afdae4": "LEVÉE DE DOUTE",
  "#hdfr:52:796425734:00f9277174c3fc915e2d": "Levée de doute, {loc}. Personne retrouvée, rien à signaler.",
  "#hdfr:10:1591726971:a1541b415a1efa7efaa9": "SUSPECT",
  "#hdfr:61:1512241676:748b4be41959f9aa16b6": "Signalement d'un individu suspect, {loc}. L'unité ratisse le secteur.",
  "#hdfr:8:1465793901:ee5b150a7ee62978a1fe": "VOL",
  "#hdfr:48:1487448382:bff8a5fe54e34ac0f843": "Vol à l'étalage signalé, {loc}. Le suspect a pris la fuite à pied.",
  "#hdfr:9:305563330:d17616d5e9b1a7ab6da1": "VOIRIE",
  "#hdfr:42:1447429537:973952d13ebbbfecee13": "Obstruction de la chaussée, {loc}. Circulation déviée.",
  "#hdfr:8:1083997282:8ce6c36c43bb7d64db08": "BRIGADE CANINE",
  "#hdfr:42:1006133640:b99e653b07d96c9ba26e": "Passage de la brigade canine terminé, {loc}. Résultat négatif.",
  "#hdfr:8:2106576102:fb33d84cc4ab320f288b": "DIFFÉREND",
  "#hdfr:50:161392300:37eb0fb47ff6f12a55ed": "Dispute familiale, {loc}. Deux unités en route.",
  "#hdfr:11:1484363404:98e3045ceb63da01a1da": "ALARME AGRESSION",
  "#hdfr:48:940462174:e16c2f1a2caebbfc323c": "Alarme agression déclenchée, {loc}. Intervention prioritaire.",
  "#hdfr:9:2042556564:2edc062c7e1f9d6bc60a": "ÉPAVE",
  "#hdfr:48:90427243:6d0b13393d3cd603dd89": "Véhicule abandonné, {loc}. Avis de mise en fourrière posé.",
  "#hdfr:6:1187048752:2aed440d431620d7d905": "ESCORTE",
  "#hdfr:48:1623573178:11074a56343b4e5cc3c1": "Escorte de sécurité demandée, {loc}. Unité affectée.",
  "#hdfr:11:1440026205:8c9f535e1cdc41a20709": "ÎLOTAGE",
  "#hdfr:43:1855829029:160cea6eecc7d96a0775": "Patrouille pédestre, {loc}. Ronde de routine.",
  "#hdfr:19:1636763192:9b123a6e6474fd664d54": "#hdfr:19:1636763192:9b123a6e6474fd664d54",
  "#hdfr:13:1605618595:b9c2b669b28bb0f384a2": "#hdfr:29:552287643:13d7847f47d48520cf72",
  "#hdfr:14:1377066761:18ff3ae2dc018856fdfe": "#hdfr:14:1377066761:18ff3ae2dc018856fdfe",
  "#hdfr:14:867954132:0723bf980ad9e8b5a16a": "#hdfr:14:867954132:0723bf980ad9e8b5a16a",
  "#hdfr:15:345898007:85b52388eb29b44db1ee": "#hdfr:18:139563706:cc1379ce46322b03cd71",
  "#hdfr:14:2028813075:22545bd753cae795f42c": "#hdfr:12:463960785:836586dcdbd2bdab48b9",
  "#hdfr:17:1692088590:58a9de49e87dfc1b66fe": "#hdfr:17:1078356252:80a3658c07158f7cacff",
  "#hdfr:15:345737981:1e826c7bfcfa8473549b": "#hdfr:18:1505413734:d93e9ef9548437b74126",
  "#hdfr:13:2002782861:46fb59344792f13cbe54": "#hdfr:13:2002782861:46fb59344792f13cbe54",
  "#hdfr:16:1329544440:9adefe759c54a4269a84": "Cité Ironworks",
  "#hdfr:14:815234271:7542161c4dec4ae68f7a": "Dépôt Grayline",
  "#hdfr:14:2070665569:9f7a14b59e11face7fec": "Arches Fenwick",
  "#hdfr:15:653945309:17241a9698e41687c508": "#hdfr:15:653945309:17241a9698e41687c508",
  "#hdfr:15:1260389694:3267a6b34c16bcd3b406": "#hdfr:15:1260389694:3267a6b34c16bcd3b406",
  "#hdfr:50:1795620231:e60cd9b950328de3122f": "Contrôle de l'intégrité de la scène, {location}. Le cordon tient.",
  "#hdfr:61:1334668726:bb9c3ca36cb22d847f60": "Porte-à-porte complémentaire, affaire « {caseTitle} ». Deux dépositions recueillies.",
  "#hdfr:59:2084822767:fc2a7dc87e8e8c311ba7": "Appel à la ligne de signalement au sujet de l'affaire {victim}. Transmis à la brigade criminelle.",
  "#hdfr:50:1783736783:e693f3e21bf1a5942894": "Extraction d'archives demandée par la brigade criminelle, dossier « {caseTitle} ».",
  "#hdfr:65:1875645037:68b45ca6c91c6862106e": "Véhicule de presse signalé près de {location}. Unités, prudence à l'approche.",
  "#hdfr:63:1065921645:98429b3c5dd091aba248": "Transport de scellés, {location} vers le dépôt central. Chaîne de conservation intacte.",
  "#hdfr:101:1130398138:6581c80d22f32ef04a6e": "Il paraît que le labo traite sa file plus vite avant 22:00, heure de l'affaire. La nuit, l'équipe est réduite au minimum.",
  "#hdfr:109:1576956440:b230848b987bfed45da0": "Vieux truc : quand la version d'un suspect contredit un document que vous avez en main, surveillez le moniteur de stress de près.",
  "#hdfr:97:1796147614:737ba6185819c440a061": "Le carnet consigne les contradictions tout seul. Ça vaut une relecture avant d'accuser qui que ce soit.",
  "#hdfr:83:2146107167:22b4422d0ddb63887542": "Ne négligez pas les auditions de témoins : ceux qui ne sont pas suspects parlent plus librement.",
  "#hdfr:73:1980485073:db37f9d90e3abc0659fe": "Relevez la messagerie régulièrement, les tuyaux arrivent au fil de l'horloge de l'affaire.",
  "#hdfr:92:476563024:7da0529ffbe69199073b": "Reliez deux indices vraiment liés sur le tableau et le fil ne réagit pas pareil. Ouvrez l'œil.",
  "#hdfr:93:1846591580:ff65329dcf1d63706499": "Un suspect est relâché après un certain nombre de questions. Préparez votre série de questions avant de vous asseoir.",
  "#hdfr:94:1559072648:3658f16f79663623da84": "Le code d'une pièce verrouillée se cache toujours ailleurs dans le dossier. C'est moins cher qu'un mandat."
 },
